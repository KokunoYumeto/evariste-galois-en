{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codex:galois-english-pdf-actual-visual-inspection:v1",
  "title": "Galois English PDF actual model visual inspection",
  "description": "A record for visual inspection that is completed only after a model actually views the rendered pages. Mechanical QA output is not evidence for this record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "inspection_kind",
    "inspection_status",
    "pdf",
    "pdf_sha256",
    "page_count",
    "render_report",
    "render_report_sha256",
    "reviewer",
    "coverage",
    "criteria",
    "page_findings",
    "overall_result",
    "attestation"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "inspection_kind": {
      "const": "actual-rendered-page-model-visual-inspection"
    },
    "inspection_status": {
      "enum": [
        "PENDING",
        "COMPLETE"
      ]
    },
    "pdf": {
      "type": "string"
    },
    "pdf_sha256": {
      "type": "string"
    },
    "page_count": {
      "type": "integer",
      "minimum": 0
    },
    "render_report": {
      "type": "string"
    },
    "render_report_sha256": {
      "type": "string"
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "session_or_task_id",
        "completed_at_utc"
      ],
      "properties": {
        "model_id": {
          "type": "string"
        },
        "session_or_task_id": {
          "type": "string"
        },
        "completed_at_utc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewed_pages",
        "full_resolution_pages_reviewed",
        "contact_sheets_reviewed"
      ],
      "properties": {
        "reviewed_pages": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "full_resolution_pages_reviewed": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "contact_sheets_reviewed": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "PENDING",
              "PASS",
              "FAIL",
              "NOT_APPLICABLE"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "page_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "page",
          "status",
          "observations"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL"
            ]
          },
          "observations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "overall_result": {
      "enum": [
        "PENDING",
        "PASS",
        "FAIL"
      ]
    },
    "attestation": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "inspection_status": {
            "const": "COMPLETE"
          }
        }
      },
      "then": {
        "properties": {
          "pdf": {
            "minLength": 1
          },
          "pdf_sha256": {
            "pattern": "^[A-F0-9]{64}$"
          },
          "page_count": {
            "minimum": 1
          },
          "render_report": {
            "minLength": 1
          },
          "render_report_sha256": {
            "pattern": "^[A-F0-9]{64}$"
          },
          "reviewer": {
            "properties": {
              "model_id": {
                "minLength": 1
              },
              "session_or_task_id": {
                "minLength": 1
              },
              "completed_at_utc": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "coverage": {
            "properties": {
              "reviewed_pages": {
                "minItems": 1
              }
            }
          },
          "criteria": {
            "items": {
              "properties": {
                "status": {
                  "enum": [
                    "PASS",
                    "FAIL",
                    "NOT_APPLICABLE"
                  ]
                }
              }
            }
          },
          "overall_result": {
            "enum": [
              "PASS",
              "FAIL"
            ]
          },
          "attestation": {
            "minLength": 40
          }
        }
      },
      "else": {
        "properties": {
          "overall_result": {
            "const": "PENDING"
          }
        }
      }
    }
  ]
}
